<?xml version="1.0" encoding="UTF-8"?>
<!-- SpotBugs / FindSecBugs exclusions. Every entry carries a justification and is reviewed by the security
     champion at each release (SOC 2 CC8.1 change management). Keep this list minimal. -->
<FindBugsFilter>
  <!-- JPA entities and immutable records expose internal representation by design -->
  <Match><Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/></Match>
  <!-- Spring beans are constructor-injected singletons; constructor validation is intentional (fail fast) -->
  <Match><Bug pattern="CT_CONSTRUCTOR_THROW"/></Match>
  <!-- Core API is a stateless OAuth2 resource server: bearer tokens are not ambient credentials, so CSRF does not apply.
       Browser traffic reaches the API only through the BFF, which enforces CSRF tokens. -->
  <Match>
    <Class name="com.wellnessz.security.config.ResourceServerSecurityConfig"/>
    <Bug pattern="SPRING_CSRF_PROTECTION_DISABLED"/>
  </Match>
  <!-- Increment 6 device-ingest chain (machine traffic only): stateless, no cookies or other ambient credentials – every request
       carries the mTLS thumbprint set by the ingress plus a per-endpoint token – so CSRF does not apply; CORS is disabled and the
       paths are never proxied by the BFF. The problem bodies written by the filter / entry points are application/problem+json
       built from fixed failure codes (closed set returned by the kernel and the E34 authenticator), never from request input.
       Covered by DeviceEndpointAuthenticationFilterTest, PlatformIntegrationTest and Increment6SecurityIntegrationTest. -->
  <Match>
    <Class name="com.wellnessz.casekernel.device.ingest.DeviceIngestSecurityConfig"/>
    <Bug pattern="SPRING_CSRF_PROTECTION_DISABLED,XSS_SERVLET"/>
  </Match>
  <Match>
    <Class name="com.wellnessz.casekernel.device.ingest.DeviceEndpointAuthenticationFilter"/>
    <Bug pattern="XSS_SERVLET"/>
  </Match>
  <!-- The logout target is validated against the IdP end_session_endpoint from trusted OIDC metadata (safeTarget) and
       the body is JSON-encoded by Jackson with content-type application/json. -->
  <Match>
    <Class name="com.wellnessz.bff.BffSecurityConfig$SpaOidcLogoutHandler"/>
    <Bug pattern="UNVALIDATED_REDIRECT,XSS_SERVLET"/>
  </Match>
  <!-- Queue SQL is assembled only from constant fragments selected by a closed switch; every user value (username, roles,
       filters, paging) is bound as a JDBC "?" parameter. Covered by Increment1IntegrationTest and QueuePerformanceTest. -->
  <Match>
    <Class name="com.wellnessz.e02.queue.QueueService"/>
    <Bug pattern="SQL_INJECTION_SPRING_JDBC,POTENTIAL_XML_INJECTION"/>
  </Match>
  <!-- Optional local OCR: the executable is one of three fixed install paths and the language list one of six fixed
       values (switch allow-lists in TesseractOcrProvider); the only other argument is a JVM-created temporary file.
       No user-controlled value reaches the command line. -->
  <Match>
    <Class name="com.wellnessz.documents.TesseractOcrProvider"/>
    <Bug pattern="COMMAND_INJECTION"/>
  </Match>
  <!-- E31: XPath selectors come only from Ed25519-signed, validated driver packages (never from request input); the
       documents are parsed by SafeXml (secure processing, no DTD / external entities). -->
  <Match>
    <Class name="com.wellnessz.e31.adapter.xml.XPathParser"/>
    <Bug pattern="XPATH_INJECTION"/>
  </Match>
  <!-- E31: SHA-1 is mandated by RFC 9562 for name-based version-5 UUIDs (deterministic observation ids); not used for security. -->
  <Match>
    <Class name="com.wellnessz.e31.support.Ids"/>
    <Bug pattern="WEAK_MESSAGE_DIGEST_SHA1"/>
  </Match>
</FindBugsFilter>
