# =============================================================================
# WellnessZ clinic gateway / Linux Device Host - USB device allow-list (SC-04, E34-HLR-04, E34-BL-003)
# Install: /etc/udev/rules.d/70-wellnessz-usb-allowlist.rules, then `udevadm control --reload`.
# Pair with the kernel parameter  usbcore.authorized_default=0  (cloud-init sets it): every
# newly attached USB device starts DE-AUTHORISED (no driver binds); only the devices matched
# below are authorised. Root hubs are always authorised by the kernel.
# Checked by tools/device-security/05_gateway_hardening_linux.sh (usb-allowlist).
#
# RECIPE ONLY - not verified on hardware in this repository. The VID:PID values are EXAMPLES:
# replace them with the approved list from the device catalogue (E32 option pack P1,
# "usbAllowList") for this site and keep this file under change control.
# USBGuard (usbguard-daemon with an allow-list generated by `usbguard generate-policy` on the
# reference device set) is a stricter alternative when the image can carry it; do not run both.
# =============================================================================

# ---- external hubs (class 09) so allow-listed devices behind them enumerate ----
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{bDeviceClass}=="09", ATTR{authorized}="1"

# ---- allow-listed medical-device interfaces (EXAMPLES - replace per site) ----
# FTDI FT232R USB-serial (e.g. breath-alcohol tester / spirometer serial cable)
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="0403", ATTR{idProduct}=="6001", ATTR{authorized}="1"
# Prolific PL2303 USB-serial
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="067b", ATTR{idProduct}=="2303", ATTR{authorized}="1"
# Approved USB Bluetooth LE adapter (only if the site uses a local BLE radio - see bluetooth/main.conf)
# ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="0a12", ATTR{idProduct}=="0001", ATTR{authorized}="1"

# ---- never allow mass storage, even on an allow-listed composite device ----
# (interface class 08; interface-level authorisation, Linux >= 4.4)
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_interface", ATTR{bInterfaceClass}=="08", ATTR{authorized}="0"
# ---- no new keyboards / HID (BadUSB) - the gateway has no HID-wedge connector ----
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_interface", ATTR{bInterfaceClass}=="03", ATTR{authorized}="0"

# ---- serial nodes of allow-listed devices: owned by the gateway service group only ----
# (the gateway reads serial devices through ser2net / serial-over-TCP on loopback - SerialConnector)
SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6001", GROUP="wellnessz", MODE="0660", SYMLINK+="wz-serial-%n"
SUBSYSTEM=="tty", ATTRS{idVendor}=="067b", ATTRS{idProduct}=="2303", GROUP="wellnessz", MODE="0660", SYMLINK+="wz-serial-%n"

# ---- audit every USB attach / detach (auditd / journald -> SIEM) ----
ACTION=="add|remove", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", RUN+="/usr/bin/logger -t wz-usb-policy -p auth.notice '$env{ACTION} usb $attr{idVendor}:$attr{idProduct} authorized=$attr{authorized}'"
