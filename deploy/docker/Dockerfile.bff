# syntax=docker/dockerfile:1.10
# =============================================================================
# WellnessZ Backend-for-Frontend - wz-bff
# Build context: repository root
#   docker build -f deploy/docker/Dockerfile.bff -t wellnessz/wz-bff:dev .
# Runtime: Temurin 21 JRE, non-root uid/gid 10001, layered Spring Boot jar,
# compatible with readOnlyRootFilesystem (only /tmp must be writable).
# Base images are pinned to exact versions directly in FROM (not via ARG) so
# Dependabot (docker ecosystem) and scanners can see and update them. Promote
# to digest pinning (@sha256:...) in your registry mirror if required by your
# change-management policy.
# =============================================================================

# ---------- build ------------------------------------------------------------
FROM maven:3.9-eclipse-temurin-26-noble AS build
WORKDIR /workspace
# Only Maven inputs are sent (see Dockerfile.bff.dockerignore)
COPY . .
RUN --mount=type=cache,target=/root/.m2/repository \
    mvn -B -ntp -pl apps/wz-bff -am package -DskipTests \
 && java -Djarmode=tools -jar apps/wz-bff/target/wz-bff.jar extract --layers --launcher --destination /extracted

# ---------- runtime ----------------------------------------------------------
FROM eclipse-temurin:21.0.12_8-jre-noble AS runtime
ARG VERSION=0.0.0-dev
ARG VCS_REF=unknown
LABEL org.opencontainers.image.title="wz-bff" \
      org.opencontainers.image.description="WellnessZ Backend-for-Frontend" \
      org.opencontainers.image.vendor="WellnessZ" \
      org.opencontainers.image.licenses="LicenseRef-Proprietary" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.source="https://github.com/OWNER/WellnessZ"

# Patch OS packages at build time and drop package caches; create the
# unprivileged runtime identity (no shell, no home).
RUN apt-get update \
 && apt-get -y upgrade --no-install-recommends \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --system --gid 10001 wellnessz \
 && useradd --system --uid 10001 --gid 10001 --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin wellnessz

WORKDIR /app
# Layers ordered from least to most frequently changing for cache efficiency.
COPY --from=build --chown=root:root --chmod=0755 /extracted/dependencies/ ./
COPY --from=build --chown=root:root --chmod=0755 /extracted/spring-boot-loader/ ./
COPY --from=build --chown=root:root --chmod=0755 /extracted/snapshot-dependencies/ ./
COPY --from=build --chown=root:root --chmod=0755 /extracted/application/ ./

# Container-aware heap sizing; fail fast on OOM so Kubernetes restarts the pod.
ENV JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=75.0 -XX:InitialRAMPercentage=50.0 -XX:+ExitOnOutOfMemoryError -XX:+UseG1GC -Djava.io.tmpdir=/tmp -Djava.security.egd=file:/dev/urandom -Dfile.encoding=UTF-8 -Duser.timezone=UTC" \
    TZ=UTC \
    LANG=C.UTF-8

# Mount a writable volume here (emptyDir / tmpfs) when the root FS is read-only.
VOLUME ["/tmp"]
USER 10001:10001
EXPOSE 8090
# Kubernetes ignores HEALTHCHECK and uses the chart's liveness/readiness probes
# on the management port; this check serves plain `docker run` / compose and
# uses only bash (/dev/tcp), no extra tooling. Helm sets MANAGEMENT_SERVER_PORT.
HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=3 \
  CMD ["bash", "-c", "exec 3<>/dev/tcp/127.0.0.1/${MANAGEMENT_SERVER_PORT:-8091} && printf 'GET /actuator/health/liveness HTTP/1.1\\r\\nHost: localhost\\r\\nConnection: close\\r\\n\\r\\n' >&3 && grep -q UP <&3"]
ENTRYPOINT ["java", "org.springframework.boot.loader.launch.JarLauncher"]
