# =============================================================================
# WellnessZ local stack - environment template
#
# Copy to `.env` (git-ignored, chmod 600) and fill in every value, OR simply run
# ./up.sh which generates a .env with random values if none exists.
#
# NEVER commit a populated .env. Local values must never be reused in any
# shared/cloud environment - those use Key Vault / Secret Manager / Vault.
#
# Generate random values with:
#   openssl rand -base64 24            # passwords
#   openssl rand -base64 32            # WZ_MASTER_KEY / WZ_PSEUDONYM_KEY (256-bit)
# =============================================================================

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_SUPERUSER_PASSWORD=
# Schema owner used by Flyway only (DDL)
WZ_MIGRATOR_DB_PASSWORD=
# Least-privilege runtime role used by the core API (DML only)
WZ_APP_DB_PASSWORD=
# BFF session-store role (schema bff only)
WZ_BFF_DB_PASSWORD=
# Owner of the separate `keycloak` database
KEYCLOAK_DB_PASSWORD=

# --- Keycloak ---------------------------------------------------------------
KEYCLOAK_ADMIN_USER=kcadmin
KEYCLOAK_ADMIN_PASSWORD=
# Must match the `wellnessz-bff` client secret in keycloak/wellnessz-realm.json.
# The realm file ships with the local-only placeholder below; change both if
# you prefer (Keycloak admin console > Clients > wellnessz-bff > Credentials).
WZ_BFF_CLIENT_SECRET=change-me-local-only

# --- Core application secrets -----------------------------------------------
# AES-256-GCM master key for ENC(...) config values and field encryption.
#   WZ_MASTER_KEY=$(openssl rand -base64 32)
WZ_MASTER_KEY=
# BFF session-encryption key (separate from the core master key).
#   WZ_BFF_MASTER_KEY=$(openssl rand -base64 32)
WZ_BFF_MASTER_KEY=
# HMAC key for analytics pseudonymised keys.
#   WZ_PSEUDONYM_KEY=$(openssl rand -base64 32)
WZ_PSEUDONYM_KEY=

# --- EHS mailbox (GreenMail IMAP user ehs-feed@wellnessz.local) --------------
WZ_IMAP_PASSWORD=
