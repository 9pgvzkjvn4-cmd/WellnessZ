{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "WellnessZ Helm values",
  "type": "object",
  "required": ["global", "secrets", "migrations", "core", "bff", "employeePortal", "managerWorkspace", "ohWorkspace", "networkPolicy"],
  "definitions": {
    "secretFile": {
      "type": "object",
      "required": ["fileName", "remoteName"],
      "properties": {
        "fileName": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "remoteName": { "type": "string", "minLength": 1 },
        "env": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "format": { "enum": ["fileRef", "path"] }
      },
      "additionalProperties": false
    },
    "component": {
      "type": "object",
      "required": ["enabled", "name", "image", "runAsUser", "ports", "resources"],
      "properties": {
        "enabled": { "type": "boolean" },
        "name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "image": {
          "type": "object",
          "required": ["repository"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string" },
            "digest": { "type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$" }
          }
        },
        "replicaCount": { "type": "integer", "minimum": 1 },
        "runAsUser": { "type": "integer", "minimum": 1 },
        "resources": {
          "type": "object",
          "required": ["requests", "limits"],
          "properties": {
            "limits": { "type": "object", "required": ["memory"] }
          }
        }
      }
    }
  },
  "properties": {
    "global": {
      "type": "object",
      "required": ["imageRegistry", "environment"],
      "properties": {
        "imageRegistry": { "type": "string", "minLength": 1 },
        "imageTag": { "type": "string" },
        "environment": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "requireImageDigests": { "type": "boolean" },
        "imagePullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] },
        "openshift": { "type": "boolean" }
      }
    },
    "secrets": {
      "type": "object",
      "required": ["provider", "mountPath"],
      "properties": {
        "provider": { "enum": ["none", "azure", "gcp", "vault"] },
        "mountPath": { "type": "string", "pattern": "^/" },
        "syncToKubernetesSecret": { "type": "boolean" },
        "csiDriver": { "enum": ["secrets-store.csi.k8s.io", "secrets-store-gke.csi.k8s.io"] },
        "gcp": { "type": "object", "properties": { "providerName": { "enum": ["gke", "gcp"] } } },
        "core": { "type": "object", "properties": { "files": { "type": "array", "items": { "$ref": "#/definitions/secretFile" } } } },
        "bff": { "type": "object", "properties": { "files": { "type": "array", "items": { "$ref": "#/definitions/secretFile" } } } },
        "migrations": { "type": "object", "properties": { "files": { "type": "array", "items": { "$ref": "#/definitions/secretFile" } } } }
      }
    },
    "migrations": {
      "type": "object",
      "required": ["mode"],
      "properties": { "mode": { "enum": ["app", "job"] } }
    },
    "containerSecurityContext": {
      "type": "object",
      "properties": {
        "allowPrivilegeEscalation": { "const": false },
        "readOnlyRootFilesystem": { "const": true },
        "privileged": { "const": false }
      }
    },
    "podSecurityContext": {
      "type": "object",
      "properties": { "runAsNonRoot": { "const": true } }
    },
    "core": { "$ref": "#/definitions/component" },
    "bff": { "$ref": "#/definitions/component" },
    "employeePortal": { "$ref": "#/definitions/component" },
    "managerWorkspace": { "$ref": "#/definitions/component" },
    "ohWorkspace": { "$ref": "#/definitions/component" },
    "partnerPortal": { "$ref": "#/definitions/component" },
    "observability": {
      "type": "object",
      "properties": {
        "logLevel": { "enum": ["", "TRACE", "DEBUG", "INFO", "WARN", "ERROR", "OFF"] },
        "rootLogLevel": { "enum": ["", "TRACE", "DEBUG", "INFO", "WARN", "ERROR", "OFF"] },
        "traceSampling": { "type": "string", "pattern": "^$|^(0(\\.[0-9]+)?|1(\\.0+)?)$" }
      },
      "additionalProperties": false
    },
    "customisation": {
      "type": "object",
      "properties": {
        "client": { "type": "string", "pattern": "^$|^[a-z][a-z0-9-]{0,30}$" },
        "featureFlags": {
          "type": "object",
          "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$" },
          "additionalProperties": { "type": ["boolean", "string", "number"] }
        },
        "migrations": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "image": {
              "type": "object",
              "properties": {
                "repository": { "type": "string" },
                "tag": { "type": "string" },
                "digest": { "type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$" },
                "path": { "type": "string", "pattern": "^/" }
              }
            },
            "configMap": { "type": "string" },
            "schemas": { "type": "string", "pattern": "^$|^[a-z_][a-z0-9_]*(,[a-z_][a-z0-9_]*)*$" },
            "table": { "type": "string", "pattern": "^[a-z_][a-z0-9_]*$" },
            "mountPath": { "type": "string", "pattern": "^/" }
          }
        }
      },
      "additionalProperties": false
    },
    "networkPolicy": {
      "type": "object",
      "required": ["enabled"],
      "properties": { "enabled": { "type": "boolean" } }
    }
  }
}
