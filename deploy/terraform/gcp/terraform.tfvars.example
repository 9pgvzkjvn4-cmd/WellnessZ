# Copy to terraform.tfvars (git-ignored). Identifiers only - no secrets.
project_id  = "my-wellnessz-prod"
region      = "europe-west4"
environment = "prod"

gke_autopilot        = true
gke_private_endpoint = false
gke_master_authorized_networks = [
  { cidr_block = "203.0.113.0/24", display_name = "corporate-egress" },
]
binauthz_enforcement_mode = "DRYRUN_AUDIT_LOG_ONLY"

sql_tier            = "db-custom-4-16384"
sql_iam_admin_group = "wellnessz-dba@example.com"

log_retention_days = 365
github_repository  = "OWNER/WellnessZ"
