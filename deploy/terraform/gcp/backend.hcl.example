# Copy to backend.hcl and run: terraform init -backend-config=backend.hcl
# Per-environment state: see environments/backend-<env>.hcl.example (one state per environment).
# Bucket requirements: uniform bucket-level access, public access prevention,
# object versioning, CMEK (kms_encryption_key), IAM limited to the CI identity.
bucket = "wellnessz-tfstate-prod"
prefix = "wellnessz/prod/gcp"
# kms_encryption_key = "projects/<p>/locations/<r>/keyRings/<kr>/cryptoKeys/tfstate"
