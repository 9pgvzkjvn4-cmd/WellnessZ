<?xml version="1.0" encoding="UTF-8"?>
<!-- Logging: human-readable locally, JSON (logstash) elsewhere for SIEM ingestion.
     PHI must never be logged: the gateway logs sequence numbers, connector ids and device instance ids only. -->
<configuration>
  <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
  <springProfile name="local | test | default">
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>
    <root level="INFO"><appender-ref ref="CONSOLE"/></root>
  </springProfile>
  <springProfile name="!(local | test | default)">
    <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
      <encoder class="net.logstash.logback.encoder.LogstashEncoder">
        <customFields>{"service":"wellnessz-device-gateway"}</customFields>
      </encoder>
    </appender>
    <root level="INFO"><appender-ref ref="JSON"/></root>
  </springProfile>
</configuration>
