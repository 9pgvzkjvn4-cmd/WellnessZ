# IntiMed edge gateway image (IM-E08-BL-008 – arm64/amd64 OCI image for site gateways): the platform jar in gateway
# mode = encrypted store-and-forward bridge from serial / file / BLE-bridge sources to the IntiMed device ingress over
# mutual TLS. Enrol once (`sdk enrol` with a one-time token), then run `sdk gateway`. Identity and queue live on /gateway.
ARG BASE=eclipse-temurin:21.0.8_9-jre-noble
FROM ${BASE}
LABEL org.opencontainers.image.title="IntiMed edge gateway" org.opencontainers.image.version="2.0.0"
RUN groupadd --system --gid 10010 gateway && useradd --system --uid 10010 --gid gateway --home-dir /gateway --shell /usr/sbin/nologin gateway \
    && usermod -aG dialout gateway \
    && mkdir -p /gateway && chown gateway:gateway /gateway \
    && apt-get update && apt-get -y upgrade && apt-get clean && rm -rf /var/lib/apt/lists/*
COPY --chown=root:root intimed-platform/target/intimed-platform.jar /opt/intimed/intimed-platform.jar
USER 10010:10010
WORKDIR /gateway
VOLUME ["/gateway"]
ENV JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=60 -XX:+ExitOnOutOfMemoryError"
ENTRYPOINT ["java", "-jar", "/opt/intimed/intimed-platform.jar", "sdk"]
CMD ["gateway", "--help"]
