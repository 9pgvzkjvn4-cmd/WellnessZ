<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <!-- IntiMed is an independent product (ADR-01): its own parent, version and release cycle. It does not depend on any
       OHCM (com.wellnessz) module; OHCM is its first reference client through the published APIs only. -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/>
  </parent>

  <groupId>io.intimed</groupId>
  <artifactId>intimed-parent</artifactId>
  <version>2.2.0</version>
  <packaging>pom</packaging>
  <name>IntiMed :: Intelligent Medical Device Integration Platform</name>

  <modules>
    <module>intimed-platform</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <bouncycastle.version>1.86</bouncycastle.version>
    <archunit.version>1.5.1</archunit.version>
    <cyclonedx.version>2.9.3</cyclonedx.version>
    <jacoco.version>0.8.16</jacoco.version>
  </properties>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <argLine>@{argLine} -XX:+EnableDynamicAgentLoading</argLine>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
