   "value": "40"
  },
  "negative": [
   "DUPLICATE",
   "MALFORMED",
   "TIME_SKEW",
   "WRONG_SUBJECT",
   "OUT_OF_RANGE"
  ]
 },
 "docs": {
  "guide": "Configure Nonin 3230 – Bluetooth LE Pulse Oximeter Profile (0x2A5E spot-check) with option P3. Standard GATT health profiles (BLP, HTP, PLX, WSS, GLS, BCS) or vendor services via gateway, tablet or kiosk; Classic SPP for older devices.",
  "troubleshooting": [
   "Check the endpoint certificate is ACTIVE in the security console",
