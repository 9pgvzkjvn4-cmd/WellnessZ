    "key": "weight_pre",
    "sel": "OBX[OBX-3.1=WPRE]/OBX-5",
    "unitSel": "OBX[OBX-3.1=WPRE]/OBX-6.1"
   },
   {
    "key": "duration",
    "sel": "OBX[OBX-3.1=DUR]/OBX-5",
    "unitSel": "OBX[OBX-3.1=DUR]/OBX-6.1"
   }
  ]
 },
