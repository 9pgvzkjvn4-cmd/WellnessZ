  "version": "1.0.0",
  "name": "Benson CCA-200mini via vendor software – audiogram XML export",
  "family": "Audiometry & hearing",
  "models": [
   "IMD-015"
  ],
  "options": [
   "P2"
  ],
  "compatibility": {
   "firmware": ">=1.0",
   "vendorSoftware": "certified versions per IntiMed lab"
  },
  "author": "IntiMed driver team",
