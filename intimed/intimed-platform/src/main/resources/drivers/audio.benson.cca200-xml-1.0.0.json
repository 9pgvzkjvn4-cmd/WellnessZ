  "bidirectional": false,
  "certification": {
   "status": "CERTIFIED",
   "lab": "IntiMed device lab (simulator golden sessions)"
  }
 },
 "transport": {
  "P2": {
   "parameters": {
    "source": "FOLDER",
    "path": "C:\\\\Benson\\\\Export",
    "pattern": "*.xml",
    "pollSeconds": 20,
    "stabilitySeconds": 3,
    "archive": "MOVE_TO_DONE",
    "serviceAccount": "secret://benson-share",
    "encoding": "UTF-8",
    "dedupKey": "sha256(file)"
   },
   "security": {
    "tls": "1.2+",
    "mtls": true
   }
  }
 },
