{
 "manifest": {
  "packageId": "imaging.ct.dicom-rdsr",
  "version": "1.0.0",
  "name": "CT scanner – DICOM RDSR & study attributes via DICOM router (DICOMweb JSON)",
  "family": "Imaging & PACS",
  "models": [
   "IMD-281"
  ],
  "options": [
   "P7"
  ],
  "compatibility": {
   "firmware": ">=1.0",
   "vendorSoftware": "certified versions per IntiMed lab"
  },
  "author": "IntiMed driver team",
  "sbomRef": "sbom/imaging.ct.dicom-rdsr-1.0.0.cdx.json",
  "captureMode": "SPOT",
  "restricted": false,
  "bidirectional": false,
  "certification": {
   "status": "CERTIFIED",
   "lab": "IntiMed device lab (simulator golden sessions)"
  }
 },
 "transport": {
  "P7": {
   "parameters": {
    "aeTitle": "INTIMED_SCP",
    "callingAeTitles": "CT01",
    "port": 11112,
    "tls": "DICOM_TLS",
    "storageClasses": "1.2.840.10008.5.1.4.1.1.88.67",
    "mwlFilter": ""
   },
   "security": {
    "tls": "1.2+",
    "mtls": true
   }
  }
 },
 "grammar": {
  "type": "DICOM_JSON",
  "identity": {
   "subject": "00100020",
   "serial": "00181000",
   "time": "00080020"
  },
  "fields": [
   {
    "key": "accession",
    "tag": "00080050"
   },
   {
    "key": "study_uid",
    "tag": "0020000D"
   },
   {
    "key": "modality",
    "tag": "00080060"
   },
   {
    "key": "body_part",
    "tag": "00180015"
   },
   {
    "key": "dlp",
    "tag": "SR:113813",
    "unit": "mGy.cm"
   },
   {
    "key": "ctdivol",
    "tag": "SR:113830",
    "unit": "mGy"
   }
  ]
 },
 "semantics": [
  {
   "key": "accession",
   "display": "Accession number",
   "local": "INTIMED-ACCESSION",
   "type": "text"
  },
  {
   "key": "study_uid",
   "display": "Study Instance UID",
   "local": "INTIMED-STUDY-UID",
   "type": "text"
  },
  {
   "key": "modality",
   "display": "Modality",
   "local": "INTIMED-MODALITY",
   "type": "text"
  },
  {
   "key": "body_part",
   "display": "Body part",
   "local": "INTIMED-BODY-PART",
   "type": "text"
  },
  {
   "key": "dlp",
   "display": "CT dose-length product (total)",
   "local": "DCM-113813",
   "ucum": "mGy.cm",
   "plausible": {
    "min": 0,
    "max": 20000
   }
  },
  {
   "key": "ctdivol",
   "display": "Mean CTDIvol",
   "local": "DCM-113830",
   "ucum": "mGy",
   "plausible": {
    "min": 0,
    "max": 500
   }
  }
 ],
 "bindings": {
  "TPL-07": {
   "fields": {
    "accession": "accession",
    "study_uid": "study_uid",
    "modality": "modality",
    "body_part": "body_part",
    "dlp": "dlp",
    "ctdivol": "ctdivol"
   }
  }
 },
 "recommendations": {
  "association": {
   "value": "WORKLIST",
   "why": "Setting rule for TPL-07 templates"
  },
  "captureMode": {
   "value": "SPOT",
   "why": "Template capture pattern"
  },
  "qualityGates": {
   "value": {},
   "why": "Driver quality-gate defaults (RR-11)"
  },
  "aeTitle": {
   "value": "INTIMED_SCP",
   "why": "Certified driver default for CT (P7)"
  },
  "callingAeTitles": {
   "value": "CT01",
   "why": "Certified driver default for CT (P7)"
  },
  "port": {
   "value": 11112,
   "why": "Certified driver default for CT (P7)"
  },
  "tls": {
   "value": "DICOM_TLS",
   "why": "DICOM TLS (PS3.15 BCP 195) between modality and router; plaintext DICOM blocked outside the imaging VLAN"
  },
  "storageClasses": {
   "value": "1.2.840.10008.5.1.4.1.1.88.67",
   "why": "Certified driver default for CT (P7)"
  }
 },
