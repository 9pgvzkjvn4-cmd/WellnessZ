  }
 },
 "transport": {
  "P8": {
   "parameters": {
    "endpoint": "/fhir/r4/Observation",
    "scopes": "system/Observation.write",
    "profileValidation": "PCHA_LITE"
   },
   "security": {
    "tls": "1.2+",
    "mtls": false,
    "oauth2": "client_credentials"
   }
  }
 },
 "grammar": {
  "type": "FHIR",
  "fields": [
   {
    "key": "steps",
    "code": "http://loinc.org|55423-8"
   },
   {
    "key": "resting_hr",
    "code": "http://loinc.org|40443-4"
   },
   {
    "key": "hrv",
    "code": "urn:intimed:local|INTIMED-HRV-SDNN"
   },
   {
    "key": "sleep",
    "code": "urn:intimed:local|INTIMED-SLEEP-DUR"
   }
  ]
 },
 "semantics": [
  {
   "key": "steps",
   "display": "Steps",
   "loinc": "55423-8",
   "ucum": "{steps}"
  },
  {
   "key": "resting_hr",
   "display": "Resting heart rate",
   "loinc": "40443-4",
   "ucum": "/min"
  },
  {
   "key": "hrv",
   "display": "HRV (SDNN)",
   "local": "INTIMED-HRV-SDNN",
   "ucum": "ms"
  },
  {
   "key": "sleep",
   "display": "Sleep duration",
   "local": "INTIMED-SLEEP-DUR",
   "ucum": "min"
  }
 ],
 "bindings": {
  "TPL-22": {
   "fields": {
    "steps": "steps",
    "resting_hr": "resting_hr",
    "hrv": "hrv",
    "sleep": "sleep"
   }
  }
 },
 "recommendations": {
  "association": {
   "value": "CONSENT",
   "why": "Setting rule for TPL-22 templates"
  },
  "captureMode": {
   "value": "SPOT",
   "why": "Template capture pattern"
  },
  "qualityGates": {
   "value": {},
   "why": "Driver quality-gate defaults (RR-11)"
  },
  "endpoint": {
   "value": "/fhir/r4/Observation",
   "why": "Certified driver default for Wearable (P8)"
  },
  "scopes": {
   "value": "system/Observation.write",
   "why": "Write-only scope for the aggregator client (RR-15)"
  },
  "profileValidation": {
   "value": "PCHA_LITE",
   "why": "Certified driver default for Wearable (P8)"
  }
 },
