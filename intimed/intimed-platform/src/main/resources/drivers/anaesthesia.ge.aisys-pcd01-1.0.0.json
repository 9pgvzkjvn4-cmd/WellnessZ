{
 "manifest": {
  "packageId": "anaesthesia.ge.aisys-pcd01",
  "version": "1.0.0",
  "name": "GE Aisys CS2 / Carestation via anaesthesia gateway (PCD-01)",
  "family": "Respiratory & anaesthesia",
  "models": [
   "IMD-247"
  ],
  "options": [
   "P4"
  ],
  "compatibility": {
   "firmware": ">=1.0",
   "vendorSoftware": "certified versions per IntiMed lab"
  },
  "author": "IntiMed driver team",
  "sbomRef": "sbom/anaesthesia.ge.aisys-pcd01-1.0.0.cdx.json",
  "captureMode": "CONTINUOUS",
  "restricted": false,
  "bidirectional": false,
  "certification": {
   "status": "CERTIFIED",
   "lab": "IntiMed device lab (simulator golden sessions)"
  }
 },
 "transport": {
  "P4": {
   "parameters": {
    "host": "intimed.local",
    "port": 2575,
    "tls": "MTLS",
    "tlsMin": "1.2",
    "sendingApplication": "AISYS_GW",
    "sendingFacility": "OR3",
    "ackMode": "ORIGINAL",
    "profile": "IHE_PCD_01",
    "timeZone": "UTC",
    "maxMessagesPerSecond": 50
   },
   "security": {
    "tls": "1.2+",
    "mtls": true
   }
  }
 },
 "grammar": {
  "type": "HL7V2",
  "messageTypes": [
   "ORU^R01"
  ],
  "identity": {
   "subject": "PID-3.1",
   "serial": "OBX-18.1",
   "time": "OBR-7",
   "timeFormat": "yyyyMMddHHmmss"
  },
  "fields": [
   {
    "key": "etco2",
    "sel": "OBX[OBX-3.1=151708]/OBX-5",
    "unitSel": "OBX[OBX-3.1=151708]/OBX-6.2"
   },
   {
    "key": "fio2",
    "sel": "OBX[OBX-3.1=152196]/OBX-5",
    "unitSel": "OBX[OBX-3.1=152196]/OBX-6.2"
   },
   {
    "key": "et_sevo",
    "sel": "OBX[OBX-3.1=152872]/OBX-5",
    "unitSel": "OBX[OBX-3.1=152872]/OBX-6.2"
   },
   {
    "key": "mac",
    "sel": "OBX[OBX-3.1=MAC]/OBX-5",
    "unitSel": "OBX[OBX-3.1=MAC]/OBX-6.2"
   },
   {
    "key": "tv",
    "sel": "OBX[OBX-3.1=151980]/OBX-5",
    "unitSel": "OBX[OBX-3.1=151980]/OBX-6.2"
   },
   {
    "key": "peep",
    "sel": "OBX[OBX-3.1=151976]/OBX-5",
    "unitSel": "OBX[OBX-3.1=151976]/OBX-6.2"
   },
   {
    "key": "hr",
    "sel": "OBX[OBX-3.1=147842]/OBX-5",
    "unitSel": "OBX[OBX-3.1=147842]/OBX-6.2"
   },
   {
    "key": "bis",
    "sel": "OBX[OBX-3.1=BIS]/OBX-5",
    "unitSel": "OBX[OBX-3.1=BIS]/OBX-6.2"
   }
  ]
 },
 "semantics": [
  {
   "key": "etco2",
   "display": "End-tidal CO2",
   "mdc": "MDC_AWAY_CO2_ET",
   "ucum": "mm[Hg]",
   "plausible": {
    "min": 0,
    "max": 100
   }
  },
  {
   "key": "fio2",
   "display": "Inspired O2 fraction",
   "loinc": "3150-0",
   "ucum": "%"
  },
  {
   "key": "et_sevo",
   "display": "End-tidal sevoflurane",
   "mdc": "MDC_CONC_AWAY_SEVOFL_ET",
   "ucum": "%"
  },
  {
   "key": "mac",
   "display": "MAC",
   "local": "INTIMED-MAC",
   "ucum": "1"
  },
  {
   "key": "tv",
   "display": "Tidal volume (expired)",
   "mdc": "MDC_VOL_AWAY_TIDAL_EXP",
   "ucum": "mL"
  },
  {
   "key": "peep",
   "display": "PEEP",
   "mdc": "MDC_VENT_PRESS_AWAY_END_EXP_POS",
   "ucum": "cm[H2O]"
  },
  {
   "key": "hr",
   "display": "Heart rate",
   "loinc": "8867-4",
   "ucum": "/min",
   "plausible": {
    "min": 20,
    "max": 250
   }
  },
  {
   "key": "bis",
   "display": "Bispectral index",
   "mdc": "MDC_EEG_BISPECTRAL_INDEX",
   "ucum": "1"
  }
 ],
 "bindings": {
  "TPL-03": {
   "fields": {
    "etco2": "etco2",
    "fio2": "fio2",
    "et_sevo": "et_sevo",
    "mac": "mac",
    "tv": "tv",
    "peep": "peep",
    "hr": "hr",
    "bis": "bis"
   }
  }
 },
