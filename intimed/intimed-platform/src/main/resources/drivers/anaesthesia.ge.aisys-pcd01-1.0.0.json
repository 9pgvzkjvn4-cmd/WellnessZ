 "tests": {
  "golden": [
   {
    "name": "nominal",
    "payload": "MSH|^~\\&|AISYS_GW|OR3|INTIMED|INTIMED|{TS}||ORU^R01^ORU_R01|{CTRL}|P|2.6|||NE|AL||UNICODE UTF-8|||IHE_PCD_001^IHE PCD^1.3.6.1.4.1.19376.1.6.1.1.1^ISO\rPID|||{{SUBJECT}}^^^HOSP^MR\rOBR|1|{{CTRL}}^INTIMED||ANES^Anaesthesia^L|||{{TS}}\rOBX|1|NM|151708^MDC_AWAY_CO2_ET^MDC|1.1.1.151708|{{V:etco2}}|266016^MDC_DIM_MMHG^MDC|||||F|||{{TS}}||||{{SERIAL}}\rOBX|2|NM|152196^MDC_CONC_AWAY_O2_INSP^MDC|1.1.1.152196|{{V:fio2}}|262688^MDC_DIM_PERCENT^MDC|||||F|||{{TS}}||||{{SERIAL}}\rOBX|3|NM|152872^MDC_CONC_AWAY_SEVOFL_ET^MDC|1.1.1.152872|{{V:et_sevo}}|262688^MDC_DIM_PERCENT^MDC|||||F|||{{TS}}||||{{SERIAL}}\rOBX|4|NM|MAC^MAC^MDC|1.1.1.MAC|{{V:mac}}|262144^MDC_DIM_DIMLESS^MDC|||||F|||{{TS}}||||{{SERIAL}}\rOBX|5|NM|151980^MDC_VOL_AWAY_TIDAL_EXP^MDC|1.1.1.151980|{{V:tv}}|263762^MDC_DIM_MILLI_L^MDC|||||F|||{{TS}}||||{{SERIAL}}\rOBX|6|NM|151976^MDC_VENT_PRESS_AWAY_END_EXP_POS^MDC|1.1.1.151976|{{V:peep}}|266048^MDC_DIM_CM_H2O^MDC|||||F|||{{TS}}||||{{SERIAL}}\rOBX|7|NM|147842^MDC_ECG_HEART_RATE^MDC|1.1.1.147842|{{V:hr}}|264864^MDC_DIM_BEAT_PER_MIN^MDC|||||F|||{{TS}}||||{{SERIAL}}\rOBX|8|NM|BIS^MDC_EEG_BISPECTRAL_INDEX^MDC|1.1.1.BIS|{{V:bis}}|262144^MDC_DIM_DIMLESS^MDC|||||F|||{{TS}}||||{{SERIAL}}\r"
