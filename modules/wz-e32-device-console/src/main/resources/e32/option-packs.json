        {"step": 3, "text": "Use the CSV template only for campaign imports; each row is still verified."}
      ],
      "diagramUrl": "/assets/devices/options/p10-manual.svg",
      "help": {
        "en": "Use only when no other option is possible. The record shows that the value was typed and which device was attested.",
