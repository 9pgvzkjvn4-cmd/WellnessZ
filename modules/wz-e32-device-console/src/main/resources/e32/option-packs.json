          "attestationFields": {"type": "array", "minItems": 4, "maxItems": 4, "default": ["MODEL", "SERIAL", "CALIBRATION_ID", "CALIBRATION_DATE"],
            "items": {"type": "string", "enum": ["MODEL", "SERIAL", "CALIBRATION_ID", "CALIBRATION_DATE"]}},
          "csvTemplate": {"type": "string", "maxLength": 500},
          "validationRules": {"type": "string", "enum": ["PACKAGE_PLAUSIBILITY"], "default": "PACKAGE_PLAUSIBILITY"},
          "allowedRoles": {"type": "array", "minItems": 1, "maxItems": 6, "default": ["OH_CLINICIAN", "OH_PHYSICIAN", "NURSING_HEAD"],
            "items": {"type": "string", "enum": ["OH_CLINICIAN", "OH_PHYSICIAN", "AME", "CMO", "NURSING_HEAD", "COLLECTOR"]}}
        }
      }
    }
  ]
