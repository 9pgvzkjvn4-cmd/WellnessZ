{
  "type": "SURVEILLANCE_EXAM",
  "version": 1,
  "bodyMapRequired": false,
  "title": "Health surveillance examination",
  "bodyMap": false,
  "requiresDiagnosis": false,
  "fitnessStandardPrompt": false,
  "protocolPrompts": [
    "Compare audiometry with the baseline audiogram (standard threshold shift)",
    "Repeat spirometry if FEV1/FVC < 0.70 or FEV1 < 80 % predicted"
