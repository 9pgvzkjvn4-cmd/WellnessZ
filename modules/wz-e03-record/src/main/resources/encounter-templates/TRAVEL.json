        {
          "key": "objective",
          "label": "Objective – examination findings",
          "type": "TEXTAREA",
          "required": false
        },
        {
          "key": "assessment",
          "label": "Assessment",
          "type": "TEXTAREA",
          "required": false
        },
        {
          "key": "plan",
          "label": "Plan",
          "type": "TEXTAREA",
          "required": true
