          "required": true,
          "options": [
            {
              "value": "YES",
              "label": "Yes"
            },
            {
              "value": "NO",
              "label": "No"
            },
            {
              "value": "UNDER_REVIEW",
              "label": "Under review"
            }
          ]
        },
        {
