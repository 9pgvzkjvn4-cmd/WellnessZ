            {
              "value": "DIARRHOEA",
              "label": "Diarrhoea"
            },
            {
              "value": "VOMITING",
              "label": "Vomiting"
            },
            {
              "value": "RASH",
              "label": "Rash"
            },
            {
              "value": "HEADACHE",
              "label": "Headache"
            },
            {
              "value": "FATIGUE",
