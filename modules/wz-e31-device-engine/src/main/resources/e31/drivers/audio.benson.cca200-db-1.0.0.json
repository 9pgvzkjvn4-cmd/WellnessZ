    "right.4000": 15,
    "gates": {
     "AUDIO_TEST_RETEST": "PASS",
     "AUDIO_AMBIENT_NOISE": "PASS"
    }
   }
  },
  {
   "name": "malformed",
   "input": "golden/audiometry/cca200-db/malformed.csv",
   "expect": {
    "error": "parse_failed"
   }
  },
  {
   "name": "edge",
   "input": "golden/audiometry/cca200-db/edge.csv",
